# Private runtime data and secrets
/config/*.local.php
/config/*production*.php
/config/*development*.php
/storage/**
!/storage/.gitkeep
/runtime/**
*.log
*.dump
*.sql.gz
*.bak
.env
.env.*
!.env.example

# Local editor/tool files
.DS_Store
.idea/
.vscode/
.phpunit.cache/

# cPanel PHP writes error_log files into the working directory
error_log

# Private config directory and provider key files (never in Git)
/config-private/
*.key

# Server-only files carried between releases by scripts/deploy/cpanel-release.sh
/apps/main/public/mgm-relay.php
/apps/main/public/mgm-forward.php
